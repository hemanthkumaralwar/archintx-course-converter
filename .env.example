# Copy this file to .env and fill in your own values. Never commit .env.

# Which LLM to use: gemini (free tier, default) or openai (paid, optional)
LLM_PROVIDER=gemini

# Google Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI — only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
